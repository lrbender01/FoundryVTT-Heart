{
  "name": "foundryvtt-heart",
  "version": "0.11.0",
  "description": "A red wet heaven slumbers fitful under the city of Spire. A FoundryVTT system for Heart - The City Beneath. Purchase at https://rowanrookanddecard.com/product/heart-the-city-beneath-rpg/",
  "main": "src/index.js",
  "scripts": {
    "empty-dist": "node ./dev-utils/empty-dist.js",
    "copy-static": "node ./dev-utils/copy-static.js",
    "build-code": "webpack --mode development",
    "build-manifest": "node ./dev-utils/build-manifest.js",
    "build-template": "node ./dev-utils/build-template.js",
    "build-all": "npm run empty-dist && npm run build-prod && npm run build-manifest -- 0.11.0 && npm run build-template && npm run copy-static",
    "build-local": "npm run build-all",
    "build-fast": "node ./dev-utils/build-fast.js",
    "watch": "node ./dev-utils/build-fast.js --watch",
    "build-prod": "webpack --mode production",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:build": "webpack --mode production --output-path node_modules/.cache/heart-build-check"
  },
  "keywords": [
    "foundryvtt"
  ],
  "author": "hitcherland",
  "license": "ISC",
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.0-rc.4",
    "css-loader": "^5.2.6",
    "eslint": "^7.29.0",
    "glob": "^10.3.4",
    "sass": "^1.35.1",
    "sass-loader": "^12.1.0",
    "style-loader": "^3.0.0",
    "terser-webpack-plugin": "^5.1.4",
    "vitest": "^3.2.0",
    "webpack": "^5.41.0",
    "webpack-cli": "^4.7.2",
    "webpack-import-glob-loader": "^1.6.3",
    "yaml": "^1.10.2"
  }
}
